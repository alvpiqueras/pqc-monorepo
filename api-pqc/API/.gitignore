# Este archivo registra las cosas que no quieres actualizar a través de Git. Se compone de archivos 
# temporales que no interesa guardar.

# ¡OJO!: Solo afecta a archivos que aún no están en Git.

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*

# Editor settings
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Logs
*.log

# Build files
dist/
build/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Local tool caches
.pytest_cache/
.mypy_cache/